# Catch Up server settings. Copy to .env.local (git-ignored) or set them in Vercel. Never prefix any of these with NEXT_PUBLIC_.

# Optional Baseten key for Route B, Muse Spark Open. Server only, keep it empty here.
BASETEN_API_KEY=
# Baseten OpenAI-compatible base URL.
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Hackathon model slug. Confirm it with GET /v1/models once the key exists.
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Dev only, empty by default. Set it in .env.local (for example meta-models/muse-spark-open) to retry once when BASETEN_MODEL answers 403 or 404. Production ignores it.
BASETEN_MODEL_FALLBACK=
# Output budget with reasoning included. Raise it if cards stop with finish_reason length.
BASETEN_MAX_TOKENS=2048
# Sampling temperature. 1.0 follows the model card and 0.3 is the gate 1 alternative.
BASETEN_TEMPERATURE=1.0
# Empty leaves top_k out of the request, and -1 turns top-k off as the model card suggests.
BASETEN_TOP_K=

# Meta Model API key for Route A, the default route. Server only, keep it empty here.
MODEL_API_KEY=
# Meta Model API base URL.
META_BASE_URL=https://api.meta.ai/v1
# Card writer that reads the transcript. Never a contributor model. An id ending in contributor is ignored and the default is used.
META_CARD_MODEL=muse-spark-1.3
# Muse Voice Transcribe model for the file endpoint in PUSH_TO_TALK mode. The same contributor rule applies.
META_ASR_MODEL=muse-voice-transcribe-1.0
# Output budget for the card call with reasoning included.
META_MAX_COMPLETION_TOKENS=4000

# Route used when a press asks for auto. Meta-only needs MODEL_API_KEY and no Baseten key.
# One of auto, open_weights, meta_api or mock. auto tries configured Baseten first, then Meta.
CATCHUP_ROUTE=meta_api
# Kill switch. 0 stops every live model call, and samples fall back to saved cards.
LIVE_ENABLED=1
# 1 allows the mock route in next dev and in tests. Production always refuses it.
ALLOW_MOCK=0
# Live presses per client IP per hour, kept in memory as a best effort guard. Mock presses never count. 0 turns it off, for a local eval server only.
RATE_LIMIT_PER_HOUR=30
# Live presses per server instance per UTC day, 1 or more. Mock presses never count.
DAILY_PRESS_CAP=500
# Auto starts Route A when Route B has no answer token after this many milliseconds.
AUTO_FALLBACK_MS=8000
