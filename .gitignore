# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any folder, desktop/ included)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Windows app build output
desktop/dist/
desktop/out/

# eval audio and raw model output (consent covers measurement, not publishing)
eval/clips/
eval/recorded/
eval/results/raw/

# synthetic sample clips for local dev, never shipped
public/samples/dev/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keys live only in .env.local or Vercel)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example env file in git
!.env.example
